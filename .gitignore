# Entorno y credenciales locales (las plantillas sí se versionan).
.env
.env.*
!.env.example
!.env.*.example

# Entorno Python opcional para DVC.
.venv-dvc/

# Credenciales específicas de DVC; nunca se comparten con Git.
.dvc/config.local

# Terraform local artifacts at any depth; provider lockfiles remain versioned.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan

# reports/.quality_gate.passed (salida cache: false de quality_gate) se versiona con git,
# como las demás salidas sin cache: así `dvc status` de un clon limpio no cambia (OPS-10).

# Pesos y checkpoints del clasificador (ML-03+): se publican en S3/MLflow, nunca en Git.
*.pt
*.pth
*.ckpt
# Excepción (MOD-1): pesos originales del P3 en el paquete de evidencias, para que el
# evaluador pueda cargar el modelo solo con esa carpeta. Mismo archivo que en S3/MLflow.
!evidencias/mod-01/model/best.pt
# Tracking local de MLflow (runs y artefactos) cuando no hay servidor remoto.
mlruns/
mlartifacts/
