# Completa estos valores locales antes de arrancar Compose; no uses credenciales de AWS.
# Para MARIADB_ROOT_PASSWORD usa un valor local fuerte (hexadecimal, sin caracteres
# reservados para URLs, simplifica su uso en DATABASE_URL).
MARIADB_ROOT_PASSWORD=

# P2-04: completa ambos valores en .env; no uses credenciales de AWS.
# Elige un usuario local y genera una contraseña (por ejemplo: openssl rand -hex 32).
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# P2-52: API key de Anthropic para el Copilot. Opcional: sin ella todo levanta y
# el chat responde que falta configurar la key. Nunca la subas a git (.env está ignorado).
ANTHROPIC_API_KEY=
# Modelo del Copilot (default claude-opus-5). Para gastar menos: claude-sonnet-5.
# COPILOT_MODEL=claude-sonnet-5

# OPS-03: MLflow usa las credenciales de MariaDB y MinIO de arriba; no necesita
# valores propios. Cambia el puerto del host solo si 5000 está ocupado (macOS lo usa
# para AirPlay).
# MLFLOW_PORT=5000

# AWS-2: clave que el dispositivo edge (laptop) manda en el encabezado X-Device-Key al
# enviar capturas a POST /edge-captures. Mínimo 16 caracteres; genérala con
# `openssl rand -hex 32` y nunca la subas a git. Vacía, el endpoint responde 503.
EDGE_DEVICE_KEY=
